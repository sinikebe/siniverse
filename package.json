{
  "name": "siniverse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "La page d’accueil des applications Siniverse.",
  "homepage": "https://siniverse.cc",
  "repository": {
    "type": "git",
    "url": "https://github.com/sinikebe/siniverse.git"
  },
  "scripts": {
    "dev": "node tools/serve.mjs",
    "start": "node tools/serve.mjs",
    "check": "node --check tools/serve.mjs && node --check api/src/worker.js",
    "test": "node --test",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler preview --name dev"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "wrangler": "4.161.0"
  }
}
